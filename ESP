	for _,l in pairs(Crosshair) do
		l.Color = col
	end
end)

-- =========================
-- ESP CORE (OTIMIZADO)
-- =========================
local DOTS = {"Head","UpperTorso","LowerTorso","LeftHand","RightHand","LeftFoot","RightFoot"}
local ESP_CACHE = {}
local HighlightCache = {}

local function ClearESP(esp, plr)
	if not esp then return end
	esp.Name.Visible = false
	esp.Box.Visible = false
	esp.Line.Visible = false
	esp.Health.Visible = false
	esp.Distance.Visible = false
	for _,c in pairs(esp.Dots) do c.Visible = false end
	local hl = HighlightCache[plr]
	if hl then
		hl.FillTransparency = 1
		hl.OutlineTransparency = 1
	end
end

local function CreateESP(plr)
	if plr == Player or ESP_CACHE[plr] then return end

	local esp = {
		Name = Drawing.new("Text"),
		Box = Drawing.new("Square"),
		Line = Drawing.new("Line"),
		Health = Drawing.new("Text"),
		Distance = Drawing.new("Text"),
		Dots = {}
	}

	esp.Name.Center = true
	esp.Name.Outline = true
	esp.Box.Filled = false

	for _,p in ipairs(DOTS) do
		local c = Drawing.new("Circle")
		c.Filled = true
		c.Visible = false
		esp.Dots[p] = c
	end

	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineTransparency = 1
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = Gui

	HighlightCache[plr] = hl
	ESP_CACHE[plr] = esp
end

RunService.RenderStepped:Connect(function()
	for plr,esp in pairs(ESP_CACHE) do
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not char or not hrp or hum.Health <= 0 then
			ClearESP(esp, plr)
			continue
		end

		local pos,vis = Camera:WorldToViewportPoint(hrp.Position)
		if not vis then
			ClearESP(esp, plr)
			continue
		end

		local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
		local scale = math.clamp(300/dist,0.9,LOW_GRAPHICS and 1.2 or 2)
		local col = ESP_ENABLED.RGB and Color3.fromHSV(tick()%1,1,1) or Color3.fromRGB(255,0,0)

		esp.Name.Visible = ESP_ENABLED.Name
		esp.Name.Text = plr.Name
		esp.Name.Position = Vector2.new(pos.X,pos.Y-35*scale)
		esp.Name.Color = col

		local w,h = 36*scale,52*scale
		esp.Box.Visible = ESP_ENABLED.Box
		esp.Box.Size = Vector2.new(w,h)
		esp.Box.Position = Vector2.new(pos.X-w/2,pos.Y-h/2)
		esp.Box.Color = col
		esp.Box.Thickness = LOW_GRAPHICS and 1 or 2

		esp.Line.Visible = ESP_ENABLED.Line
		esp.Line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
		esp.Line.To = Vector2.new(pos.X,pos.Y)
		esp.Line.Color = col
		esp.Line.Thickness = LOW_GRAPHICS and 1 or 2

		esp.Health.Visible = ESP_ENABLED.Health and not (LOW_GRAPHICS and dist > 600)
		esp.Health.Text = "HP: "..math.floor(hum.Health)
		esp.Health.Position = Vector2.new(pos.X,pos.Y+h/2+4)
		esp.Health.Color = col

		esp.Distance.Visible = ESP_ENABLED.Distance and not (LOW_GRAPHICS and dist > 600)
		esp.Distance.Text = math.floor(dist).."m"
		esp.Distance.Position = Vector2.new(pos.X,pos.Y+h/2+18)
		esp.Distance.Color = col

		for name,c in pairs(esp.Dots) do
			local part = char:FindFirstChild(name)
			if ESP_ENABLED.Skeleton and part then
				local p2d,ok = Camera:WorldToViewportPoint(part.Position)
				c.Visible = ok
				if ok then
					c.Position = Vector2.new(p2d.X,p2d.Y)
					c.Radius = LOW_GRAPHICS and 2 or 3
					c.Color = col
				end
			else
				c.Visible = false
			end
		end

		local hl = HighlightCache[plr]
		if ESP_ENABLED.Highlight and not LOW_GRAPHICS then
			hl.Adornee = char
			hl.FillTransparency = 0.5
			hl.OutlineTransparency = 0
			hl.FillColor = col
			hl.OutlineColor = col
		else
			hl.FillTransparency = 1
			hl.OutlineTransparency = 1
		end
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	local esp = ESP_CACHE[plr]
	if esp then
		ClearESP(esp, plr)
		esp.Name:Remove()
		esp.Box:Remove()
		esp.Line:Remove()
		esp.Health:Remove()
		esp.Distance:Remove()
		for _,c in pairs(esp.Dots) do c:Remove() end
		if HighlightCache[plr] then HighlightCache[plr]:Destroy() end
	end
	ESP_CACHE[plr] = nil
	HighlightCache[plr] = nil
end)

for _,p in ipairs(Players:GetPlayers()) do
	CreateESP(p)
end
Players.PlayerAdded:Connect(CreateESP) 
